generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Clinic {
  id      String  @id @default(cuid())
  name    String
  logoUrl String?

  doctorName       String?
  doctorLicense    String?
  doctorPhone      String?
  doctorSpecialty  String?
  doctorBranch     String?
  doctorUniversity String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  patients       Patient[]
  questionnaires ClinicalQuestionnaire[]

  appointments           Appointment[]
  appointmentEvents      AppointmentEvent[]
  scheduleAvailabilities ScheduleAvailability[]
  scheduleBlocks         ScheduleBlock[]
  scheduleSettings       ScheduleSettings?

  whatsappConversations WhatsAppConversation[]
  whatsappMessages      WhatsAppMessage[]
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  name     String?
  password String?

  role String @default("DOCTOR")

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  accounts Account[]
  sessions Session[]

  appointmentEvents AppointmentEvent[]

  assignedWhatsAppConversations WhatsAppConversation[] @relation("WhatsAppConversationAssignedUser")

  isBlocked Boolean @default(false)

  stripeCustomerId   String? @unique
  stripeSubId        String? @unique
  subscriptionStatus String  @default("inactive")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
}

model Patient {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  firstName String
  lastName  String?

  birthDate DateTime?
  gender    String?

  phone String?
  email String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultations   Consultation[]
  treatments      Treatment[]
  photos          Photo[]
  metrics         HairMetric[]
  transplants     TransplantProcedure[]
  clinicalAnswers PatientClinicalAnswer[]
  prescriptions   Prescription[]
  appointments    Appointment[]

  whatsappConversations WhatsAppConversation[]

  @@index([clinicId])
}

model Consultation {
  id String @id @default(cuid())

  clinicId String

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  date DateTime @default(now())

  norwoodLevel Int?

  notes String?

  createdAt DateTime @default(now())

  photos        Photo[]
  metrics       HairMetric[]
  prescriptions Prescription[]

  @@index([clinicId])
}

model HairMetric {
  id String @id @default(cuid())

  clinicId String

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  zone String?

  density   Float?
  thickness Float?

  notes String?

  createdAt DateTime @default(now())

  @@index([clinicId])
}

model Photo {
  id String @id @default(cuid())

  clinicId String

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  url String

  zone  String?
  notes String?

  timelineOrder       Int?
  timelineLabel       String?
  excludeFromTimeline Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([clinicId])
  @@index([patientId])
  @@index([consultationId])
  @@index([zone])
}

model Treatment {
  id String @id @default(cuid())

  clinicId String

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  medication String

  dosage    String?
  frequency String?

  startDate DateTime?
  endDate   DateTime?

  notes String?

  createdAt DateTime @default(now())

  @@index([clinicId])
}

model Prescription {
  id String @id @default(cuid())

  clinicId String

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  date DateTime @default(now())

  diagnosis     String?
  generalNotes  String?
  doctorName    String?
  doctorLicense String?
  doctorPhone   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PrescriptionItem[]

  @@index([clinicId])
  @@index([patientId])
  @@index([consultationId])
}

model PrescriptionItem {
  id String @id @default(cuid())

  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  medication   String
  presentation String?
  dosage       String?
  frequency    String?
  duration     String?
  indications  String?

  order Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([prescriptionId])
}

model TransplantProcedure {
  id String @id @default(cuid())

  clinicId String

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  date DateTime

  technique String?
  method    String?

  grafts Int?

  extractedFollicularUnits Int?
  implantedFollicularUnits Int?

  extractedFollicles Int?
  implantedFollicles Int?

  donorArea     String?
  recipientArea String?

  notes String?

  anesthesiaType String?
  anesthesiaMl   Float?

  extractionStart DateTime?
  extractionEnd   DateTime?

  implantationStart DateTime?
  implantationEnd   DateTime?

  observations String?
  medicalTeam  String?
  nurses       String?

  createdAt DateTime @default(now())

  blocks ProcedureBlock[]

  @@index([clinicId])
}

model ProcedureBlock {
  id String @id @default(cuid())

  procedureId String
  procedure   TransplantProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  blockNumber Int
  rowIndex    Int

  enf1 String?
  enf2 String?

  uf        Int?
  follicles Int?

  createdAt DateTime @default(now())

  @@index([procedureId])
}

model ClinicalQuestionnaire {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  title    String  @default("Expediente clínico inicial")
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions ClinicalQuestion[]

  @@index([clinicId])
}

model ClinicalQuestion {
  id String @id @default(cuid())

  questionnaireId String
  questionnaire   ClinicalQuestionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  questionText String
  order        Int
  isRequired   Boolean @default(false)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers PatientClinicalAnswer[]

  @@index([questionnaireId])
}

model PatientClinicalAnswer {
  id String @id @default(cuid())

  clinicId String

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  questionId String?
  question   ClinicalQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  questionTextSnapshot String
  answerText           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([patientId, questionId])
  @@index([clinicId])
  @@index([patientId])
  @@index([questionId])
}

/**
 * AGENDA MODELS
 */

model Appointment {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  title String?

  patientName  String
  patientPhone String
  patientEmail String?

  startAt DateTime
  endAt   DateTime

  timezone String @default("America/Mexico_City")

  status AppointmentStatus @default(PENDING)
  source AppointmentSource @default(MANUAL)

  appointmentType String?
  notes           String?

  reminderSentAt     DateTime?
  confirmationSentAt DateTime?
  confirmedAt        DateTime?
  cancelledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events                AppointmentEvent[]
  whatsappConversations WhatsAppConversation[]

  @@index([clinicId])
  @@index([patientId])
  @@index([startAt])
  @@index([endAt])
  @@index([status])
  @@index([clinicId, startAt])
}

model AppointmentEvent {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  actorUserId String?
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  type   AppointmentEventType
  source AppointmentEventSource

  message  String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([clinicId])
  @@index([appointmentId])
  @@index([actorUserId])
  @@index([type])
  @@index([source])
  @@index([createdAt])
  @@index([clinicId, createdAt])
  @@index([appointmentId, createdAt])
}

model ScheduleAvailability {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  dayOfWeek Int

  startTime String
  endTime   String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
  @@index([clinicId, dayOfWeek])
}

model ScheduleBlock {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  title String?

  startAt DateTime
  endAt   DateTime

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
  @@index([startAt])
  @@index([endAt])
  @@index([clinicId, startAt])
}

model ScheduleSettings {
  id String @id @default(cuid())

  clinicId String @unique
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  timezone String @default("America/Mexico_City")

  defaultAppointmentMinutes Int @default(60)
  minimumBookingNoticeHours Int @default(2)
  reminderHoursBefore       Int @default(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * WHATSAPP AGENT MODELS
 */

model WhatsAppConversation {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  assignedUserId String?
  assignedUser   User?   @relation("WhatsAppConversationAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  phoneNumber String
  displayName String?

  status        WhatsAppConversationStatus @default(OPEN)
  currentIntent WhatsAppConversationIntent @default(NONE)

  requiresHuman    Boolean @default(false)
  escalationReason String?

  context Json?

  lastMessageAt  DateTime?
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  closedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages WhatsAppMessage[]

  @@index([clinicId])
  @@index([patientId])
  @@index([appointmentId])
  @@index([assignedUserId])
  @@index([phoneNumber])
  @@index([status])
  @@index([currentIntent])
  @@index([requiresHuman])
  @@index([lastMessageAt])
  @@index([clinicId, phoneNumber])
  @@index([clinicId, status])
  @@index([clinicId, lastMessageAt])
}

model WhatsAppMessage {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  provider          String?
  providerMessageId String? @unique

  direction WhatsAppMessageDirection
  sender    WhatsAppMessageSender

  contentType WhatsAppMessageContentType @default(TEXT)

  text String?

  status WhatsAppMessageStatus

  rawPayload      Json?
  interpretedData Json?

  errorMessage String?

  receivedAt  DateTime?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
  @@index([conversationId])
  @@index([direction])
  @@index([sender])
  @@index([status])
  @@index([createdAt])
  @@index([clinicId, createdAt])
  @@index([conversationId, createdAt])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentSource {
  MANUAL
  WHATSAPP_AI
}

enum AppointmentEventType {
  CREATED
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
  REMINDER_SENT
  CONFIRMATION_REQUEST_SENT
  PATIENT_CONFIRMED
  PATIENT_REQUESTED_DOCTOR
}

enum AppointmentEventSource {
  MANUAL
  WHATSAPP_AI
  SYSTEM
  PATIENT
}

enum WhatsAppConversationStatus {
  OPEN
  WAITING_FOR_PATIENT
  WAITING_FOR_STAFF
  ESCALATED
  CLOSED
}

enum WhatsAppConversationIntent {
  NONE
  BOOK_APPOINTMENT
  RESCHEDULE_APPOINTMENT
  CANCEL_APPOINTMENT
  CONFIRM_ATTENDANCE
  REQUEST_DOCTOR
  GENERAL_QUESTION
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageSender {
  PATIENT
  AI_AGENT
  DOCTOR
  SYSTEM
}

enum WhatsAppMessageContentType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  INTERACTIVE
  UNKNOWN
}

enum WhatsAppMessageStatus {
  RECEIVED
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

/**
 * AUTH MODELS
 */

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String @id @default(cuid())
  sessionToken String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expires DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
